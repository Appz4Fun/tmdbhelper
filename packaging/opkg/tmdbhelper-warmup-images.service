[Unit]
Description=TMDBHelper image cache warmer
After=kodi.service entware.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/media/CACHE_DRIVE

[Service]
Type=simple
ExecStart=/opt/bin/warmup-rs --mode=images
Environment=RUST_LOG=warmup_rs=info,warn
Environment=WARMUP_CONCURRENCY=25
EnvironmentFile=-/opt/etc/warmup-rs.env
Restart=on-failure
RestartSec=60
Nice=15
IOSchedulingClass=2
IOSchedulingPriority=7
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=tmdbhelper-warmup-images

[Install]
WantedBy=multi-user.target
