# Settings for the warmup-rs services. Package upgrades keep this file.
# Each line sets one environment variable. A warmup-rs flag has the same name
# in lowercase with dashes, for example WARMUP_STATE_DB and --state-db.

# Metadata mode needs a TMDB API v3 key. Remove the # and add your key.
#WARMUP_TMDB_API_KEY=your-key

# Number of concurrent requests to TMDB.
#WARMUP_CONCURRENCY=40

# Set these if your files aren't in the default locations.
#WARMUP_ITEM_DETAILS_DB=/storage/.kodi/userdata/addon_data/plugin.video.themoviedb.helper/database_07/ItemDetails.db
#WARMUP_STATE_DB=/var/media/CACHE_DRIVE/tmdb/scriptcache/state.db
#WARMUP_TEXTURES_DB=/var/media/CACHE_DRIVE/tmdb/Textures13.db
#WARMUP_THUMBNAILS_DIR=/var/media/CACHE_DRIVE/tmdb/Thumbnails
